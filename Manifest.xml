<?xml version="1.0" encoding="UTF-8"?>
<Manifest>
  <id>exemplo-copia-build</id>
  <name>exemplo-copia-build</name>
  <version>1.0.0</version>
  <outputDir>build</outputDir>
  <sourceFolders>src</sourceFolders>

  <properties>
    <buildDir>build</buildDir>
    <publishDir>x</publishDir>
    <copyBuild>false</copyBuild>
  </properties>

  <!-- Ative selecionando o profile release na CLI. -->
  <profiles>
    <release>
      <buildType>Release</buildType>
      <properties>
        <copyBuild>true</copyBuild>
      </properties>
    </release>
  </profiles>

  <tasks>
    <!-- Primeira task: recria a pasta x depois de um build bem-sucedido. -->
    <task>
      <id>recriar-destino</id>
      <phase>build</phase>
      <when>after</when>
      <order>10</order>
      <command>powershell</command>
      <args>-NoProfile</args>
      <args>-Command</args>
      <args>if ('${properties.copyBuild}' -ne 'true') { exit 0 }; $target = '${properties.publishDir}'; if (Test-Path -LiteralPath $target) { Remove-Item -LiteralPath $target -Recurse -Force }; New-Item -ItemType Directory -Path $target -Force | Out-Null</args>
      <workingDir>${project.dir}</workingDir>
      <failOnError>true</failOnError>
    </task>

    <!-- Segunda task: espera a primeira e copia build para x. -->
    <task>
      <id>copiar-build</id>
      <phase>build</phase>
      <when>after</when>
      <order>20</order>
      <dependsOn>recriar-destino</dependsOn>
      <command>powershell</command>
      <args>-NoProfile</args>
      <args>-Command</args>
      <args>if ('${properties.copyBuild}' -ne 'true') { exit 0 }; $source = '${properties.buildDir}'; $target = '${properties.publishDir}'; if (!(Test-Path -LiteralPath $source)) { throw "Pasta de build nao encontrada: $source" }; Copy-Item -Path (Join-Path $source '*') -Destination $target -Recurse -Force</args>
      <workingDir>${project.dir}</workingDir>
      <failOnError>true</failOnError>
    </task>
  </tasks>
</Manifest>
